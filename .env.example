# Auth0 FGA credentials. Copy this file to .env.local and fill it in.
# Dashboard: https://dashboard.fga.dev -> Settings -> Create Client
# Docs: https://docs.fga.dev/integration/getting-your-api-keys

# Region: us1 (US), eu1 (EU) or au1 (AU). Keep the URL and audience in the same region.
FGA_API_URL=https://api.us1.fga.dev
FGA_API_AUDIENCE=https://api.us1.fga.dev/
FGA_API_TOKEN_ISSUER=auth.fga.dev

FGA_CLIENT_ID=
FGA_CLIENT_SECRET=

# Shown in the popup when you create a client. `npm run setup` fills in FGA_MODEL_ID
# (and FGA_STORE_ID if it can create the store).
FGA_STORE_ID=
FGA_MODEL_ID=

# true  = HIGHER_CONSISTENCY on every check/listObjects (workshop default: sees writes immediately)
# false = MINIMIZE_LATENCY (Auth0 FGA default: faster, may serve cached results for ~10-20s)
FGA_HIGHER_CONSISTENCY=true
